# Server Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:post%40gre8851@localhost:5432/Syncaura

# Auth
JWT_SECRET=your_jwt_secret_here
JWT_ACCESS_SECRET=syncaura_access_secret_123;
JWT_REFRESH_SECRET=syncaura_access_refresh_secret_123 ;
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Reset password
RESET_TOKEN_SECRET=syncura_reset_token_secret_123;
RESET_TOKEN_EXPIRES_MIN=15

# Email (Ethereal for dev)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your_ethereal_username
EMAIL_PASS=your_ethereal_password
EMAIL_FROM=your_ethereal_email@example.com

# Client
CLIENT_URL=http://localhost:3000

# Slack Bot Configuration
SLACK_BOT_TOKEN=dummyslackbottoken
SLACK_SIGNING_SECRET=dummyslacksigningsecret
SLACK_APP_TOKEN=dummyslackapptoken

# GitHub API Configuration (optional)
GITHUB_CLIENT_ID=dummygithubclientid
GITHUB_CLIENT_SECRET=dummygithubclientsecret

# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account.json

# PostgreSQL Database
DATABASE_URL=postgresql://postgres:post%40gre8851@localhost:5432/Syncaura
PORT=5000
DB_USER=postgres
DB_PASSWORD="post@gre8851"
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Syncaura

# AI Chatbot Integration (ollama or gemini)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
GEMINI_API_KEY=your_gemini_api_key_here